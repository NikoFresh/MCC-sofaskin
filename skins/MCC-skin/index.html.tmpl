#set global $page = "index"

<!DOCTYPE html>
<html lang="$lang">
  #include "templates/head.html.tmpl"
  <body class="bg-neutral-100 text-neutral-900">
    <!-- Header -->
    #include "templates/header.html.tmpl"
    <!-- End header -->
    <main class="mx-4">
      <div class="container mx-auto pb-6">

      <!-- Stato stazione -->
      <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-neutral-800" role="status">
        <p id="freshweather"></p>
        <script>
          window.addEventListener("load", () => checkDiff("$current.dateTime.format('%m/%d/%Y %I:%M:%S %p (%Z)')"));
        </script>
        #if $getVar('Extras.mqtt_enable', None) == 'true'
        <!-- Mqtt -->
        <div class="flex items-center">
          <div class="online-indicator" id="indicator">
            <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse motion-reduce:animate-none" id="indicator-1"></span>
          </div>
          <p id="mqttStatus">$obs.label.mqttConnecting</p>
        </div>
        #end if
      </div>

      <!-- Avviso pioggia + modale -->
      #include "templates/precipAlert.html.tmpl"

      <section aria-label="Condizioni attuali">
        #set $has_webcam = $getVar('Extras.webcam_url', None)
        #set $has_radar = $getVar('Extras.radar_url', None)
        #set $has_both = $has_webcam and $has_radar
        #set $has_either = $has_webcam or $has_radar
        <div class="grid grid-cols-1 #if $has_either then 'xl:grid-cols-2' else ''# gap-4">

          <!-- Valori -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 content-start">

            <!-- Temperatura -->
            <div class="card col-span-2 md:col-span-3">
              <div class="flex items-end justify-between gap-4">
                <div>
                  <h2 class="lbl">$obs.label.outTemp</h2>
                  <p id="outTemp" class="mt-1 text-5xl font-semibold tracking-tight tabular-nums">$current.outTemp</p>
                </div>
                <p class="lbl text-right">$obs.label.appTemp<br><span id="heatIndex" class="text-lg font-medium text-neutral-900 tabular-nums">$current.appTemp</span></p>
              </div>
              <p class="sub">$obs.label.maxAbbr.capitalize() <b>$day.outTemp.max</b> $day.outTemp.maxtime.format("%H:%M") <span aria-hidden="true">·</span> $obs.label.minAbbr.capitalize() <b>$day.outTemp.min</b> $day.outTemp.mintime.format("%H:%M")</p>
            </div>

            <!-- Umidità -->
            <div class="card">
              <h2 class="lbl">$obs.label.outHumidity</h2>
              <p id="outHumidity" class="val">$current.outHumidity</p>
              <p class="sub">$obs.label.maxAbbr.capitalize() <b>$day.outHumidity.max</b> $day.outHumidity.maxtime.format("%H:%M")<br>$obs.label.minAbbr.capitalize() <b>$day.outHumidity.min</b> $day.outHumidity.mintime.format("%H:%M")</p>
            </div>

            <!-- Pressione -->
            <div class="card">
              <h2 class="lbl">$obs.label.barometer</h2>
              <p id="barometer" class="val">$current.barometer</p>
              <p class="sub">$obs.label.maxAbbr.capitalize() <b>$day.barometer.max</b> $day.barometer.maxtime.format("%H:%M")<br>$obs.label.minAbbr.capitalize() <b>$day.barometer.min</b> $day.barometer.mintime.format("%H:%M")</p>
            </div>

            <!-- Vento -->
            <div class="card">
              <h2 class="lbl">$obs.label.wind <span aria-hidden="true">·</span> $current.windDir.ordinal_compass</h2>
              <p id="windSpeed" class="val">$current.windSpeed</p>
              <p class="sub">$obs.label.maxAbbr.capitalize() <b>$day.windGust.max</b> $day.windGust.maxtime.format("%H:%M")<br>$obs.label.avgAbbr.capitalize() <b>$day.windSpeed.avg</b></p>
            </div>

            <!-- Pioggia -->
            <div class="card">
              <h2 class="lbl">$obs.label.rain</h2>
              <p id="dayRain" class="val">$day.rain.sum</p>
              <p class="sub">$obs.label.rainRate <b id="rainRate">$current.rainRate</b><br>$obs.label.rainRate $obs.label.maxAbbr <b>$day.rainRate.max</b></p>
            </div>

            <!-- Punto di rugiada -->
            <div class="card">
              <div class="flex items-center justify-between">
                <h2 class="lbl">$obs.label.dewpoint</h2>
                <span class="relative group">
                  <button type="button" aria-label="Informazioni sul punto di rugiada" class="text-neutral-500 rounded focus-ring"><i class="fas fa-circle-question" aria-hidden="true"></i></button>
                  <span role="tooltip" class="pointer-events-none absolute right-0 bottom-full mb-2 w-56 rounded-lg bg-neutral-900 px-3 py-2 text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">$obs.label.dewPointTooltip</span>
                </span>
              </div>
              <p id="dewpoint" class="val">$current.dewpoint</p>
              <p class="sub">$obs.label.maxAbbr.capitalize() <b>$day.dewpoint.max</b> $day.dewpoint.maxtime.format("%H:%M")<br>$obs.label.minAbbr.capitalize() <b>$day.dewpoint.min</b> $day.dewpoint.mintime.format("%H:%M")</p>
            </div>

            <!-- Wind chill -->
            <div class="card">
              <div class="flex items-center justify-between">
                <h2 class="lbl">$obs.label.windChill</h2>
                <span class="relative group">
                  <button type="button" aria-label="Informazioni sul wind chill" class="text-neutral-500 rounded focus-ring"><i class="fas fa-circle-question" aria-hidden="true"></i></button>
                  <span role="tooltip" class="pointer-events-none absolute right-0 bottom-full mb-2 w-56 rounded-lg bg-neutral-900 px-3 py-2 text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">$obs.label.windChillTooltip</span>
                </span>
              </div>
              <p id="windchill" class="val">$current.windchill</p>
              <p class="sub">$obs.label.maxAbbr.capitalize() <b>$day.windchill.max</b> $day.windchill.maxtime.format("%H:%M")<br>$obs.label.minAbbr.capitalize() <b>$day.windchill.min</b> $day.windchill.mintime.format("%H:%M")</p>
            </div>
          </div>

          <!-- Webcam / Radar -->
          #if $has_either
          <div class="card p-3 sm:p-4 self-start">
            #if $has_both
            <input type="radio" id="webcam" name="weather-view" class="peer/webcam sr-only" checked />
            <input type="radio" id="radar" name="weather-view" class="peer/radar sr-only" />
            <div class="mb-3 flex justify-center">
              <div class="inline-flex rounded-full bg-header-bg/10 p-1 text-sm">
                <label for="webcam" class="cursor-pointer rounded-full px-4 py-1.5 text-neutral-600 peer-checked/webcam:bg-white peer-checked/webcam:text-header-bg peer-checked/webcam:font-medium peer-checked/webcam:shadow-sm peer-focus-visible/webcam:ring-2 peer-focus-visible/webcam:ring-sky-500">Webcam</label>
                <label for="radar" class="cursor-pointer rounded-full px-4 py-1.5 text-neutral-600 peer-checked/radar:bg-white peer-checked/radar:text-header-bg peer-checked/radar:font-medium peer-checked/radar:shadow-sm peer-focus-visible/radar:ring-2 peer-focus-visible/radar:ring-sky-500">Radar</label>
              </div>
            </div>
            #end if
            #if $has_webcam
            <img
              class="webcam-image w-full object-cover block rounded-xl peer-checked/radar:hidden"
              src="$Extras.webcam_url?$current.dateTime.raw"
              alt="Webcam dal vivo"
            />
            #end if
            #if $has_radar
            <img
              class="radar-image w-full object-contain #if $has_both then 'hidden' else 'block'# peer-checked/radar:block xl:max-h-[25vw] rounded-xl"
              src="$Extras.radar_url?$current.dateTime.raw"
              alt="Radar meteo"
            />
            #end if
          </div>
          #end if
        </div>
      </section>

      <!-- Dati secondari -->
      <section class="mt-4 grid grid-cols-1 xl:grid-cols-3 gap-4 items-start">

        <!-- Un anno fa -->
        <!--Leap Year Code -->
          #set $yr = int($day.dateTime.format("%Y"))%4
          #if $yr == 0
            #if $yr % 100 == 0
              #if $yr % 400 == 0
                #if $day.dateTime.format("%d-%b") == '29-Feb'
                  #set $n = 1461
                #else if $day.dateTime.format("%d-%b") >= '01-Mar'
                  #set $n = 366
                #else
                  #set $n = 365
                #end if
              #else
                #set $n = 365
              #end if
            #else
              #if $day.dateTime.format("%d-%b") == '29-Feb'
                #set $n = 1461
              #else if $day.dateTime.format("%d-%b") >= '01-Mar'
                #set $n = 366
              #else
                #set $n = 365
              #end if
            #end if
          #else
            #set $yrNew = ($yr - 1)
            #if $yrNew % 100 == 0
              #if $yrNew % 400 == 0
                #if $day.dateTime.format("%d-%b") < '01-Mar'
                  #set $n = 366
                #else
                  #set $n = 365
                #end if
              #end if
            #else
              #set $n = 365
            #end if
          #end if
        <details class="card group">
          <summary class="flex cursor-pointer list-none items-center justify-between h2 [&::-webkit-details-marker]:hidden">
            <span>$obs.label.oneYearAgo ($days_ago($days_ago=$n).dateTime.format("%d-%b(%Y)"))</span>
            <span class="text-header-bg transition-transform group-open:rotate-90" aria-hidden="true">›</span>
          </summary>
          <dl class="mt-3">
            <div class="row"><dt>$obs.label.outTemp $obs.label.maxF</dt><dd>$days_ago($days_ago=$n).outTemp.max · $days_ago($days_ago=$n).outTemp.maxtime.format("%H:%M")</dd></div>
            <div class="row"><dt>$obs.label.outTemp $obs.label.minF</dt><dd>$days_ago($days_ago=$n).outTemp.min · $days_ago($days_ago=$n).outTemp.mintime.format("%H:%M")</dd></div>
            <div class="row"><dt>$obs.label.outHumidity $obs.label.maxF</dt><dd>$days_ago($days_ago=$n).outHumidity.max · $days_ago($days_ago=$n).outHumidity.maxtime.format("%H:%M")</dd></div>
            <div class="row"><dt>$obs.label.outHumidity $obs.label.minF</dt><dd>$days_ago($days_ago=$n).outHumidity.min · $days_ago($days_ago=$n).outHumidity.mintime.format("%H:%M")</dd></div>
            <div class="row"><dt>$obs.label.barometer $obs.label.maxM</dt><dd>$days_ago($days_ago=$n).barometer.max · $days_ago($days_ago=$n).barometer.maxtime.format("%H:%M")</dd></div>
            <div class="row"><dt>$obs.label.barometer $obs.label.minM</dt><dd>$days_ago($days_ago=$n).barometer.min · $days_ago($days_ago=$n).barometer.mintime.format("%H:%M")</dd></div>
            <div class="row"><dt>$obs.label.rain $obs.label.total</dt><dd>$days_ago($days_ago=$n).rain.sum</dd></div>
            <div class="row"><dt>$obs.label.rainRate $obs.label.maxF</dt><dd>$days_ago($days_ago=$n).rainRate.max · $days_ago($days_ago=$n).rainRate.maxtime.format("%H:%M")</dd></div>
            <div class="row"><dt>$obs.label.wind $obs.label.maxM</dt><dd>$days_ago($days_ago=$n).wind.max $day.wind.gustdir · $days_ago($days_ago=$n).wind.maxtime.format("%H:%M")</dd></div>
          </dl>
        </details>

        <!-- Almanacco -->
        #set $sun_altitude = $almanac.sun.alt
        #if $sun_altitude < 0
        #set $sun_None="<i>(Always down)</i>"
        #else
        #set $sun_None="<i>(Always up)</i>"
        #end if

        <details class="card group xl:col-span-2">
          <summary class="flex cursor-pointer list-none items-center justify-between h2 [&::-webkit-details-marker]:hidden">
            <span>$obs.label.almanac</span>
            <span class="text-header-bg transition-transform group-open:rotate-90" aria-hidden="true">›</span>
          </summary>
          <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-x-8">

            <div>
              <h3 class="mt-2 text-sm font-semibold text-neutral-900">$obs.label.sun</h3>
              <dl>
                <div class="row"><dt>$obs.label.startCivilTwilight</dt><dd>$almanac(horizon=-6).sun(use_center=1).rise</dd></div>
                <div class="row"><dt>$obs.label.sunrise</dt><dd>$almanac.sun.rise.string($sun_None)</dd></div>
                <div class="row"><dt>$obs.label.sunTransit</dt><dd>$almanac.sun.transit</dd></div>
                <div class="row"><dt>$obs.label.sunset</dt><dd>$almanac.sun.set.string($sun_None)</dd></div>
                <div class="row"><dt>$obs.label.endCivilTwilight</dt><dd>$almanac(horizon=-6).sun(use_center=1).set</dd></div>
                <div class="row"><dt>$obs.label.azimuth</dt><dd>$("%.1f&deg;" % $almanac.sun.az)</dd></div>
                <div class="row"><dt>$obs.label.altitude</dt><dd>$("%.1f&deg;" % $sun_altitude)</dd></div>
                <div class="row"><dt>$obs.label.rightAscension</dt><dd>$("%.1f&deg;" % $almanac.sun.ra)</dd></div>
                <div class="row"><dt>$obs.label.declination</dt><dd>$("%.1f&deg;" % $almanac.sun.dec)</dd></div>
                #if $almanac.next_equinox.raw > $almanac.next_solstice.raw
                <div class="row"><dt>$obs.label.solstice</dt><dd>$almanac.next_solstice</dd></div>
                <div class="row"><dt>$obs.label.equinox</dt><dd>$almanac.next_equinox</dd></div>
                #else
                <div class="row"><dt>$obs.label.equinox</dt><dd>$almanac.next_equinox</dd></div>
                <div class="row"><dt>$obs.label.solstice</dt><dd>$almanac.next_solstice</dd></div>
                #end if
              </dl>
            </div>

            <div>
              <h3 class="mt-2 text-sm font-semibold text-neutral-900">$obs.label.moon</h3>
              <dl>
                <div class="row"><dt>$obs.label.moonrise</dt><dd>$almanac.moon.rise</dd></div>
                <div class="row"><dt>$obs.label.moonTransit</dt><dd>$almanac.moon.transit</dd></div>
                <div class="row"><dt>$obs.label.moonset</dt><dd>$almanac.moon.set</dd></div>
                <div class="row"><dt>$obs.label.azimuth</dt><dd>$("%.1f&deg;" % $almanac.moon.az)</dd></div>
                <div class="row"><dt>$obs.label.altitude</dt><dd>$("%.1f&deg;" % $almanac.moon.alt)</dd></div>
                <div class="row"><dt>$obs.label.rightAscension</dt><dd>$("%.1f&deg;" % $almanac.moon.ra)</dd></div>
                <div class="row"><dt>$obs.label.declination</dt><dd>$("%.1f&deg;" % $almanac.moon.dec)</dd></div>
                #if $almanac.next_full_moon.raw < $almanac.next_new_moon.raw
                <div class="row"><dt>$obs.label.moonFull</dt><dd>$almanac.next_full_moon</dd></div>
                <div class="row"><dt>$obs.label.moonNew</dt><dd>$almanac.next_new_moon</dd></div>
                #else
                <div class="row"><dt>$obs.label.moonNew</dt><dd>$almanac.next_new_moon</dd></div>
                <div class="row"><dt>$obs.label.moonFull</dt><dd>$almanac.next_full_moon</dd></div>
                #end if
                <div class="row"><dt>$obs.label.moonPhase</dt><dd>$almanac.moon_phase ($almanac.moon_fullness% full)</dd></div>
              </dl>
            </div>
          </div>
        </details>
      </section>

      <!-- Charts -->
      <section class="mt-10" aria-labelledby="charts-title">
        <h2 id="charts-title" class="h2 mb-3">$obs.label.charts</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 no-js gap-4">
          <div id="outTempChart" class="card p-2 h-[40vh]"></div>
          <div id="rainChart" class="card p-2 h-[40vh]"></div>
          <div id="windChart" class="card p-2 h-[40vh]"></div>
          <div id="windDirChart" class="card p-2 h-[40vh]"></div>
          <div id="heatIndexChart" class="card p-2 h-[40vh]"></div>
          <div id="barometerChart" class="card p-2 h-[40vh]"></div>
        </div>
        <noscript>
          <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
            <img src="daytempdew.png" alt="temperatures" class="rounded-xl"/>
            <img src="dayrain.png" alt="rain" class="rounded-xl"/>
            <img src="daywind.png" alt="wind" class="rounded-xl"/>
            <img src="daywinddir.png" alt="Hi Wind" class="rounded-xl"/>
            <img src="daywindvec.png" alt="Wind Vector" class="rounded-xl"/>
            <img src="daytempheat.png" alt="Heat index / Wind Chill" class="rounded-xl"/>
            <img src="daybarometer.png" alt="barometer" class="rounded-xl"/>
            #if $day.inTemp.has_data
            <img src="dayinside.png" alt="Inside" class="rounded-xl"/>
            #end if
            <img src="dayinhumid.png" alt="Inside/Outside Humidity" class="rounded-xl"/>
            #if $day.radiation.has_data
            <img src="dayradiation.png" alt="Radiation" class="rounded-xl"/>
            #end if
            #if $day.UV.has_data
            <img src="dayuv.png" alt="UV Index" class="rounded-xl"/>
            #end if
            #if $day.rxCheckPercent.has_data
            <img src="dayrx.png" alt="day rx percent" class="rounded-xl"/>
            #end if
            #if $day.lightning_strike_count.has_data
            <img src="daylightning.png" alt="Lightning" class="rounded-xl"/>
            #end if
            #if $day.extraTemp1.has_data
            <img src="daypond.png" alt="Pond Temperatures" class="rounded-xl"/>
            #end if
          </div>
        </noscript>
      </section>
      </div>
    </main>

    <!-- Footer -->
    #include "templates/footer.html.tmpl"
    <!-- End footer-->

    #if $getVar('Extras.mqtt_enable', None) == 'true'
        <script
        src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.2/mqttws31.min.js"
        type="text/javascript"
        ></script>
        <script src="./js/liveUpdates.js?v2.11"></script>
    #end if
    <script src="./js/charts.js?v1"></script>
  </body>
</html>