<!-- Parte superiore (Statica) -->
<div id="header" class="px-8 pt-6 bg-header-bg">
    <div class="lg:max-w-[75%] mx-auto text-left relative z-10 text-white">
        <div class="flex items-center gap-3 mb-2">
            <a href="$Extras.web_url">
                <h1 class="text-4xl font-semibold tracking-tight">
                    $station.location
                </h1>
            </a>
        </div>

        <div class="flex flex-wrap items-center gap-2 mb-2 text-sm text-white/85 font-medium">
            <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-map-pin"></i>
                <span class="font-mono">
                    $station.latitude[0]°$station.latitude[1]'$station.latitude[2],
                    $station.longitude[0]°$station.longitude[1]'$station.longitude[2]
                </span>
            </div>
            <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-mountain"></i>
                <span class="font-mono">$station.altitude</span>
            </div>
        </div>

        <p class="text-base text-white/90 font-medium">
            $obs.label.lastUpdate: $current.dateTime $current.dateTime.format("%Z")
        </p>
    </div>
</div>

<!-- Barra di navigazione (Sticky SOLO su PC, separata da #header) -->
<div class="px-8 md:sticky md:top-0 md:z-50 bg-header-bg border-b border-white/15 mb-4 pt-4 pb-3 pt-1">
    <div class="lg:max-w-[75%] mx-auto relative">
        <div class="flex items-center justify-between flex-wrap gap-4">
            
            <!-- Menu PC -->
            <nav class="flex-1">
                <div class="hidden md:flex flex-row items-center gap-1.5">
                    <a href="index.html" class="#if $page == 'index' then 'bg-white/20 text-white font-semibold' else 'text-white/80 hover:bg-white/10 hover:text-white'# px-4 py-2 rounded-full text-base transition-colors">
                        $obs.label.today
                    </a>
                    <a href="week.html" class="#if $page == 'week' then 'bg-white/20 text-white font-semibold' else 'text-white/80 hover:bg-white/10 hover:text-white'# px-4 py-2 rounded-full text-base transition-colors">
                        $obs.label.week
                    </a>
                    <a href="month.html" class="#if $page == 'month' then 'bg-white/20 text-white font-semibold' else 'text-white/80 hover:bg-white/10 hover:text-white'# px-4 py-2 rounded-full text-base transition-colors">
                        $obs.label.month
                    </a>
                    <a href="year.html" class="#if $page == 'year' then 'bg-white/20 text-white font-semibold' else 'text-white/80 hover:bg-white/10 hover:text-white'# px-4 py-2 rounded-full text-base transition-colors">
                        $obs.label.year
                    </a>
                    <a href="summary.html" class="#if $page == 'summary' then 'bg-white/20 text-white font-semibold' else 'text-white/80 hover:bg-white/10 hover:text-white'# px-4 py-2 rounded-full text-base transition-colors">
                        $obs.label.summary
                    </a>
                    <a href="vaia.html" class="#if $page == 'vaia' then 'bg-white/20 text-white font-semibold' else 'text-white/80 hover:bg-white/10 hover:text-white'# px-4 py-2 rounded-full text-base transition-colors">
                        Vaia
                    </a>
                </div>
                
                <!-- Tasto Menu Mobile -->
                <div class="md:hidden">
                    <button class="outline-none mobile-menu-button p-2 -ml-2 rounded-lg hover:bg-white/10 transition-colors">
                        <svg class="w-6 h-6 text-white" x-show="!showMenu" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" stroke="currentColor">
                            <path d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <!-- IG e Pulsante Extra -->
            <div class="flex items-center gap-3">
                #if $getVar('Extras.instagram_enable', None) == 'true'
                <a href="$Extras.instagram_url" class="p-2 text-white/80 text-xl transition-colors hover:text-white hover:bg-white/10 rounded-full">
                    <i class="fab fa-instagram"></i>
                </a>
                #end if
                
                #if $getVar('Extras.extra_btn_enable', None) == 'true'
                <a data-umami-event="extra_header_btn" href="$Extras.extra_btn_url" class="bg-lime-400 text-gray-900 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-lime-300 hover:shadow-lg shadow-lime-500/25 whitespace-nowrap">
                    <i class="$Extras.extra_btn_icon mr-1.5"></i> $Extras.extra_btn_text
                </a>
                #end if
            </div>
        </div>

        <!-- Menu Mobile (originale, si apre verso il basso) -->
        <div class="hidden mobile-menu mt-4 pt-4 border-t border-white/20">
            <ul class="space-y-1">
                <li>
                    <a href="index.html" class="block px-3 py-3 text-white/80 text-lg rounded-lg transition-colors hover:text-white hover:bg-white/10 #if $page == 'index' then 'bg-white/10 text-white' else ''#">
                        $obs.label.today
                    </a>
                </li>
                <li>
                    <a href="week.html" class="block px-3 py-3 text-white/80 text-lg rounded-lg transition-colors hover:text-white hover:bg-white/10 #if $page == 'week' then 'bg-white/10 text-white' else ''#">
                        $obs.label.week
                    </a>
                </li>
                <li>
                    <a href="month.html" class="block px-3 py-3 text-white/80 text-lg rounded-lg transition-colors hover:text-white hover:bg-white/10 #if $page == 'month' then 'bg-white/10 text-white' else ''#">
                        $obs.label.month
                    </a>
                </li>
                <li>
                    <a href="year.html" class="block px-3 py-3 text-white/80 text-lg rounded-lg transition-colors hover:text-white hover:bg-white/10 #if $page == 'year' then 'bg-white/10 text-white' else ''#">
                        $obs.label.year
                    </a>
                </li>
                <li>
                    <a href="summary.html" class="block px-3 py-3 text-white/80 text-lg rounded-lg transition-colors hover:text-white hover:bg-white/10 #if $page == 'summary' then 'bg-white/10 text-white' else ''#">
                        $obs.label.summary
                    </a>
                </li>
                <li>
                    <a href="vaia.html" class="block px-3 py-3 text-white/80 text-lg rounded-lg transition-colors hover:text-white hover:bg-white/10 #if $page == 'vaia' then 'bg-white/10 text-white' else ''#">
                        Vaia
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<script>
    const btn = document.querySelector("button.mobile-menu-button");
    const menu = document.querySelector(".mobile-menu");

    btn.addEventListener("click", () => {
        menu.classList.toggle("hidden");
    });
</script>
