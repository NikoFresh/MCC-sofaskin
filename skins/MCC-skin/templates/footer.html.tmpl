<footer class="bg-header-bg text-white/90 text-sm mt-8 px-4 py-8">
    <div class="container mx-auto">

        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
            <dt>$obs.label.stationHw</dt>
            <dd class="text-white">$station.hardware</dd>
            <dt>$obs.label.stationSw</dt>
            <dd class="text-white">WeeWX v$station.version</dd>
            <dt>$obs.label.weewxUptime</dt>
            <dd class="text-white">$station.uptime.long_form</dd>
            <dt>$obs.label.serverUptime</dt>
            <dd class="text-white">$station.os_uptime.long_form</dd>
        </dl>

        <a href="$Extras.cronitor_url" class="mt-3 inline-block underline underline-offset-2 hover:text-white">$obs.label.cronitorMessage</a>

        <div class="mt-6 pt-4 border-t border-white/15 flex flex-wrap gap-x-4 gap-y-1">
            <p>$obs.label.poweredBy <a href="https://weewx.com" class="underline underline-offset-2 hover:text-white">WeeWX</a></p>
            <p>$obs.label.warningMessage</p>
            <p>© $latest.dateTime.format("%Y") $Extras.copyright_name</p>
            <a href="mailto:$Extras.email" class="underline underline-offset-2 hover:text-white">$obs.label.contactUs</a>
            <a href="https://github.com/NikoFresh/MCC-sofaskin" class="underline underline-offset-2 hover:text-white" target="_blank" rel="noopener">
                <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
            </a>
        </div>

    </div>
</footer>
